<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for the app, its Electron helpers and the bundled core. V8 needs
  JIT pages; nothing else is asked for: Forja records no audio or video, and the core and engine
  reach the network and the GPU without entitlements outside the App Sandbox.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
